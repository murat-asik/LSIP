{
  "name": "lsip",
  "version": "3.0.2",
  "description": "Local Security Intelligence Platform",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.main.json && vite build",
    "package": "npm run build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "koffi": "^3.1.2",
    "lucide-react": "^0.475.0",
    "sqlite3": "^6.0.1",
    "winston": "^3.17.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.7.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "puppeteer": "^25.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.1.0"
  },
  "build": {
    "extraResources": [
      {
        "from": "vendor/yara-x",
        "to": "tools/yara-x"
      },
      {
        "from": "vendor/forensics/lsip-forensics",
        "to": "tools/forensics"
      }
    ],
    "appId": "com.b0om.lsip",
    "productName": "LSIP v3.0",
    "directories": {
      "output": "release/3.0.2-updated"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  }
}
